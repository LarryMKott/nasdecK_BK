 "/api/raid/cc": {
  "get": {
   "description": "阵列卡一致性检查（Consistency Check）。\n\n仅对存在的硬件 RAID 逻辑盘（VD）执行；本机为 JBOD 直通时无 VD，接口直接返回明确错误（不崩溃）。\n- GET  ?vd=0         ：查询该 VD 的 CC 进度与状态（idle/running/paused + 百分比）\n- POST {vd, action}  ：action = start|pause|resume|stop（stop 后不可恢复）\nCC 为只读扫描（不改数据），但会抬升磁盘负载，前端在开始前需二次确认。",
   "operationId": "api_raid_cc_api_raid_cc_get",
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {}
      }
     },
     "description": "Successful Response"
    }
   },
   "summary": "Api Raid Cc"
  },
  "post": {
   "description": "阵列卡一致性检查（Consistency Check）。\n\n仅对存在的硬件 RAID 逻辑盘（VD）执行；本机为 JBOD 直通时无 VD，接口直接返回明确错误（不崩溃）。\n- GET  ?vd=0         ：查询该 VD 的 CC 进度与状态（idle/running/paused + 百分比）\n- POST {vd, action}  ：action = start|pause|resume|stop（stop 后不可恢复）\nCC 为只读扫描（不改数据），但会抬升磁盘负载，前端在开始前需二次确认。",
   "operationId": "api_raid_cc_api_raid_cc_post",
   "requestBody": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/RaidCcRequest"
      }
     }
    },
    "required": false
   },
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {}
      }
     },
     "description": "Successful Response"
    }
   },
   "summary": "Api Raid Cc"
  }
 },
 "/api/raid/cc/schedule": {
  "get": {
   "description": "一致性检查定时调度配置。\nGET：返回当前配置；POST {enabled, period, hour, minute, weekday, vd}：保存。\n配置本身与是否存在 VD 无关（保存合法）；真正触发由 _check_cc_schedule 按时执行，\n无 VD 时静默跳过。前端仅在存在硬件逻辑盘时展示该配置 UI。",
   "operationId": "api_raid_cc_schedule_api_raid_cc_schedule_get",
